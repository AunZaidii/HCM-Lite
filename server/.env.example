NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Supabase -> Connect -> Session pooler (IPv4). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region e.g. ap-northeast-1>.pooler.supabase.com:5432/postgres
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Optional: create the first Admin from env instead of the setup wizard
ADMIN_EMAIL=
ADMIN_PASSWORD=
# AI provider (any OpenAI-compatible endpoint with tool calling). Server-side only.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_REASONING_EFFORT=low
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20
